# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PACKETSCOPE_SESSION_SECRET: HMAC-SHA256 secret for operator session tokens (set strong random hex in production)
PACKETSCOPE_SESSION_SECRET=""

# PACKETSCOPE_DB_PATH: Path to relational SQLite WAL file (defaults to ./data/packetscope.db)
PACKETSCOPE_DB_PATH="./data/packetscope.db"
